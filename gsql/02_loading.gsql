USE GRAPH FraudGraph

// Run against the *derived* CSVs produced by agent/build_graph_csvs.py,
// which pre-joins transactions.csv + identity.csv into loader-friendly files:
//   customers.csv, cards.csv, transactions.csv, devices.csv, regions.csv,
//   emails.csv, edges_made.csv, edges_from_device.csv, edges_billed_in.csv,
//   edges_purchaser_email.csv, edges_next.csv, closed_cases.csv,
//   edges_closed_involves.csv, edges_closed_on_card.csv, edges_closed_connected.csv

CREATE LOADING JOB load_fraud_graph FOR GRAPH FraudGraph {

  DEFINE FILENAME f_customers = "$sys.data_root/customers.csv";
  DEFINE FILENAME f_cards = "$sys.data_root/cards.csv";
  DEFINE FILENAME f_txns = "$sys.data_root/transactions.csv";
  DEFINE FILENAME f_devices = "$sys.data_root/devices.csv";
  DEFINE FILENAME f_regions = "$sys.data_root/regions.csv";
  DEFINE FILENAME f_emails = "$sys.data_root/emails.csv";
  DEFINE FILENAME f_closed = "$sys.data_root/closed_cases.csv";

  DEFINE FILENAME e_made = "$sys.data_root/edges_made.csv";
  DEFINE FILENAME e_device = "$sys.data_root/edges_from_device.csv";
  DEFINE FILENAME e_billed = "$sys.data_root/edges_billed_in.csv";
  DEFINE FILENAME e_email = "$sys.data_root/edges_purchaser_email.csv";
  DEFINE FILENAME e_next = "$sys.data_root/edges_next.csv";
  DEFINE FILENAME e_closed_inv = "$sys.data_root/edges_closed_involves.csv";
  DEFINE FILENAME e_closed_card = "$sys.data_root/edges_closed_on_card.csv";
  DEFINE FILENAME e_closed_conn = "$sys.data_root/edges_closed_connected.csv";

  LOAD f_customers TO VERTEX Customer VALUES ($"customer_id") USING header="true", separator=",";
  LOAD f_cards TO VERTEX Card VALUES ($"card_id", $"card_network", $"card_type") USING header="true", separator=",";
  LOAD f_txns TO VERTEX Transaction VALUES ($"txn_id", $"amount", $"ts", $"dt_seconds", $"product_cd",
        $"channel", $"addr1", $"addr2", $"risk_score", $"p_email", $"r_email") USING header="true", separator=",";
  LOAD f_devices TO VERTEX DeviceProfile VALUES ($"device_key", $"device_info", $"os", $"browser", $"screen", $"is_new_flag") USING header="true", separator=",";
  LOAD f_regions TO VERTEX BillingRegion VALUES ($"region_code") USING header="true", separator=",";
  LOAD f_emails TO VERTEX EmailDomain VALUES ($"domain") USING header="true", separator=",";
  LOAD f_closed TO VERTEX ClosedCase VALUES ($"case_id", $"outcome", $"pattern", $"exposure_usd",
        $"opened_at", $"closed_at", $"analyst_notes") USING header="true", separator=",";

  LOAD e_made TO EDGE MADE VALUES ($"card_id", $"txn_id") USING header="true", separator=",";
  LOAD e_device TO EDGE FROM_DEVICE VALUES ($"txn_id", $"device_key") USING header="true", separator=",";
  LOAD e_billed TO EDGE BILLED_IN VALUES ($"txn_id", $"region_code") USING header="true", separator=",";
  LOAD e_email TO EDGE PURCHASER_EMAIL VALUES ($"txn_id", $"domain") USING header="true", separator=",";
  LOAD e_next TO EDGE NEXT VALUES ($"txn_id_a", $"txn_id_b") USING header="true", separator=",";
  LOAD e_closed_inv TO EDGE INVOLVES VALUES ($"case_id", $"txn_id") USING header="true", separator=",";
  LOAD e_closed_card TO EDGE ON_CARD VALUES ($"case_id", $"card_id") USING header="true", separator=",";
  LOAD e_closed_conn TO EDGE CONNECTED_TO VALUES ($"case_id", $"card_id") USING header="true", separator=",";
}
