# ---------------------------------------------------------------------------
# .env.example — copy this to .env and fill in your real values.
# The .env file is gitignored and will NEVER be committed to the repo.
# Do NOT paste actual credentials in this chat or share them anywhere.
# ---------------------------------------------------------------------------

# ── TigerGraph Savanna ──────────────────────────────────────────────────────
# Your Savanna instance host URL (include https://)
# e.g. https://abc123.i.tgcloud.io
TG_HOST=https://<your-savanna-host>.i.tgcloud.io

# TigerGraph login credentials
TG_USERNAME=tigergraph
TG_PASSWORD=<your-password>

# The graph name you created (or that the schema will create)
TG_GRAPH=FraudGraph

# ── xAI / Grok ──────────────────────────────────────────────────────────────
# Your xAI API key from console.x.ai
XAI_API_KEY=xai-<your-key-here>
