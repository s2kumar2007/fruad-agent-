# ---------------------------------------------------------------------------
# .env.example — copy this to .env and fill in your real values.
# The .env file is gitignored and will NEVER be committed to the repo.
# Do NOT paste actual credentials in this chat or share them anywhere.
# ---------------------------------------------------------------------------

# ── TigerGraph Savanna ──────────────────────────────────────────────────────
# Your Savanna instance host URL (include https://)
# e.g. https://abc123.i.tgcloud.io
TG_HOST=https://<your-savanna-host>.i.tgcloud.io

# The graph name you created (must match what's in the Savanna console)
TG_GRAPH=FraudGraph

# Pre-generated Database Secret from the Savanna console:
#   Savanna → your graph → Admin panel → Database Secrets → Add Secret
# Copy the secret string shown there — you cannot retrieve it again after closing the dialog.
# Do NOT use TG_USERNAME / TG_PASSWORD here; Savanna's REST API uses token-based auth only.
TG_SECRET=<your-db-secret-string>

# ── xAI / Grok ──────────────────────────────────────────────────────────────
# Your xAI API key from console.x.ai
XAI_API_KEY=xai-<your-key-here>
